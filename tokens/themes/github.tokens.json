{
  "$description": "GitHub's open Primer palette and font stacks (@primer/primitives 11.10.0, MIT), light and dark. The hue is GitHub's green: the primary button in light, and the success foreground in dark, since this system's dark buttons take a dark label. The page is Primer's default background, and surfaces its muted one.",
  "$extensions": {
    "io.github.filipgutica.design-system": {
      "name": "GitHub"
    }
  },
  "font-ui": {
    "$type": "fontFamily",
    "$value": [
      "Mona Sans VF",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "Noto Sans Backtick Fix",
      "Noto Sans",
      "Helvetica",
      "Arial",
      "sans-serif",
      "Apple Color Emoji",
      "Segoe UI Emoji"
    ]
  },
  "font-mono": {
    "$type": "fontFamily",
    "$value": [
      "ui-monospace",
      "SFMono-Regular",
      "SF Mono",
      "Menlo",
      "Consolas",
      "Liberation Mono",
      "monospace"
    ]
  },
  "light": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1216, 0.5333, 0.2392],
        "hex": "#1f883d"
      }
    },
    "color-bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "color-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9647, 0.9725, 0.9804],
        "hex": "#f6f8fa"
      }
    },
    "color-surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "color-surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9373, 0.949, 0.9608],
        "hex": "#eff2f5"
      }
    },
    "color-row-hover": {
