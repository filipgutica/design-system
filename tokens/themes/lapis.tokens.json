{
  "$description": "The Workbench site's blue: a cobalt in light and a periwinkle in dark.",
  "$extensions": {
    "io.github.filipgutica.design-system": {
      "name": "Lapis"
    }
  },
  "light": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1686, 0.349, 0.8392],
        "hex": "#2b59d6"
      }
    }
  },
  "dark": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5412, 0.6588, 1],
        "hex": "#8aa8ff"
      }
    }
  }
}
