{
  "$description": "The filip-stack site's violet: a saturated violet in light and a lilac in dark.",
  "$extensions": {
    "io.github.filipgutica.design-system": {
      "name": "Iris"
    }
  },
  "light": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4275, 0.2471, 0.8392],
        "hex": "#6d3fd6"
      }
    }
  },
  "dark": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7059, 0.6118, 1],
        "hex": "#b49cff"
      }
    }
  }
}
