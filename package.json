{
  "name": "@filipgutica/design-system",
  "version": "0.0.0-development",
  "description": "Filip's design language, tokens, and component catalogue for any framework",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "language/",
    "tokens/",
    "scripts/build-tokens.mjs"
  ],
  "scripts": {
    "prepublishOnly": "pnpm verify",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm test && pnpm pack --dry-run && publint"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipgutica/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/filipgutica/design-system/issues"
  },
  "homepage": "https://github.com/filipgutica/design-system#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9"
  }
}
