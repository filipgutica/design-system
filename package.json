{
  "name": "@filipgutica/design-system",
  "version": "0.0.0-development",
  "description": "Filip's design language, tokens, and component catalogue for any framework",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./language/tokens.css",
    "./ui-sdk.css": "./language/ui-sdk.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./themes/*.tokens.json": "./dist/themes/*.tokens.json",
    "./tokens.json": "./dist/tokens.json",
    "./theme-inputs.json": "./dist/theme-inputs.json",
    "./theme-mapper": {
      "types": "./theme-mapper/index.d.ts",
      "default": "./theme-mapper/index.js"
    },
    "./theme-builder": {
      "types": "./theme-mapper/theme-builder.d.ts",
      "default": "./theme-mapper/theme-builder.js"
    },
    "./open-vsx": {
      "types": "./open-vsx/index.d.ts",
      "default": "./open-vsx/index.js"
    },
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./language/*": "./language/*",
    "./package.json": "./package.json"
  },
  "files": [
    "language/",
    "dist/",
    "fonts/",
    "theme-mapper/",
    "open-vsx/"
  ],
  "scripts": {
    "prepublishOnly": "pnpm verify",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:react": "tsc -p tests/react-smoke && playwright test -c tests/react-smoke",
    "test:catalogue": "tsc -p tests/catalogue && playwright test -c tests/catalogue",
    "site:build": "node scripts/build-site.mjs",
    "test:site": "node scripts/build-site.mjs --projects tests/fixtures/projects.json && tsc -p tests/site && playwright test -c tests/site",
    "verify": "pnpm tokens:check && pnpm test && pnpm test:react && pnpm test:catalogue && pnpm test:site && pnpm pack --dry-run && publint"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipgutica/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/filipgutica/design-system/issues"
  },
  "homepage": "https://github.com/filipgutica/design-system#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "@vitejs/plugin-react": "6.2.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "jszip": "3.10.2",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
