{
  "$description": "The wtree site's green, a step darker in light so a selected row reads at 4.5:1: a leaf green in light and a pale green in dark.",
  "$extensions": {
    "io.github.filipgutica.design-system": {
      "name": "Fern"
    }
  },
  "light": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1529, 0.4588, 0.1647],
        "hex": "#27752a"
      }
    }
  },
  "dark": {
    "$type": "color",
    "color-project": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.498, 0.8157, 0.5137],
        "hex": "#7fd083"
      }
    }
  }
}
